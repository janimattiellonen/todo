NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL=postgresql://todo:todo@localhost:5435/todo

# Email transport. Use `mock` locally; `resend` requires RESEND_API_KEY.
EMAIL_TRANSPORT=mock
EMAIL_FROM=noreply@example.com
# RESEND_API_KEY=re_...

# Public base URL — used to build magic-link URLs in emails.
APP_URL=http://localhost:5172

# HMAC secret for tamper-detection on the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_COOKIE_SECRET=replace-me-with-a-32-byte-random-string
