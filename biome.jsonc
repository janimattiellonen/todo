{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      // Ignore build output
      "!build",
      // Ignore files that are generated by React Router
      "!.react-router",
      // Ignore the throwaway Phase 0 prototype (zero-quality-bar per the plan)
      "!prototype"
    ]
  },
  "formatter": {
    "enabled": true,
    "useEditorconfig": true
  },
  "css": {
    "parser": {
      // Tailwind is in the scaffold for now and will be removed in #5 (StyleX).
      // Enable the parser hint so @apply / @import "tailwindcss" don't error.
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      // Disable Solid domain rules because they conflict with React.
      // https://biomejs.dev/linter/domains/#solid
      "solid": "none",
      // Disable Qwik domain rules because they conflict with React.
      // https://biomejs.dev/linter/domains/#qwik
      "qwik": "none"
    },
    "rules": {
      "recommended": true,
      "a11y": "on",
      "security": "on",
      "suspicious": "on",
      "style": {
        // Allow React Router exports (loader, action, meta, etc.).
        // https://biomejs.dev/linter/rules/use-component-export-only-modules/#allowexportnames
        "useComponentExportOnlyModules": {
          "level": "on",
          "options": {
            "allowExportNames": [
              "json",
              "loader",
              "action",
              "headers",
              "meta",
              "links",
              "scripts"
            ]
          }
        },
        // https://biomejs.dev/linter/rules/use-filenaming-convention/
        "useFilenamingConvention": {
          "level": "on",
          "options": {
            "filenameCases": ["PascalCase", "camelCase", "kebab-case"]
          }
        },
        // https://biomejs.dev/linter/rules/use-naming-convention/
        "useNamingConvention": {
          "level": "on",
          "options": {
            "conventions": [
              {
                "selector": {
                  "kind": "importAlias",
                  "scope": "any"
                },
                // Ignore import-alias matching by accepting anything.
                // The team convention is to prefix aliases with the module name
                // (e.g. `Customer as CustomerList_Customer`).
                "match": ".+"
              },
              {
                "selector": {
                  "kind": "objectLiteralProperty",
                  "scope": "any"
                },
                "formats": [
                  // "Enum" constant properties should be in CONSTANT_CASE.
                  "CONSTANT_CASE",
                  "camelCase",
                  // SQL column names should be in snake_case.
                  "snake_case"
                ]
              }
            ]
          }
        },
        // Use `type` instead of `interface` for type definitions.
        // https://biomejs.dev/linter/rules/use-consistent-type-definitions/
        "useConsistentTypeDefinitions": {
          "level": "on",
          "options": {
            "style": "type"
          }
        }
      },
      "correctness": {
        // Never use import extensions because StyleX does not work with them.
        // E.g. `import { theme } from "~/tokens.stylex.js";` does not work.
        // https://biomejs.dev/linter/rules/use-import-extensions/
        "useImportExtensions": "off",
        // Biome's resolver cannot follow React 19's dynamic CJS exports.
        // TypeScript already validates imports via `pnpm types`.
        // https://github.com/biomejs/biome/issues/9143
        "noUnresolvedImports": "off"
      },
      "performance": {
        // Allow namespace imports for recommended use of StyleX.
        // https://biomejs.dev/linter/rules/no-namespace-import/
        "noNamespaceImport": "off"
      },
      "complexity": {
        // Conflicts with TypeScript's `noPropertyAccessFromIndexSignature`.
        // https://biomejs.dev/linter/rules/use-literal-keys/
        "useLiteralKeys": "off"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
